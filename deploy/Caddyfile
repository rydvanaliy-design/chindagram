# Caddy reverse proxy for Chindagram.
# Replace YOUR-SUBDOMAIN with the DuckDNS name you created (see DEPLOY.md).
# Caddy fetches and renews the HTTPS certificate automatically — no setup.

YOUR-SUBDOMAIN.duckdns.org {
	encode gzip

	# Only meaningful over HTTPS, so it lives here rather than in next.config.js
	# (local development runs over plain http).
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	reverse_proxy localhost:3000
}
