# Template. Copy to .env and fill in. Safe to commit — no real values here.
# The same variable names are set in Vercel's dashboard for production.

# --- Database (Supabase Postgres, Singapore) --------------------------------
# DATABASE_URL is the POOLER (port 6543) — what the app uses at runtime.
# DIRECT_URL is the direct connection (5432) — used only by `prisma migrate`.
# Replace PASTE_DB_PASSWORD with the database password you set when creating
# the project (Supabase dashboard -> Project Settings -> Database).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:PASTE_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:PASTE_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# --- Supabase Storage (uploads) ---------------------------------------------
# The URL and anon key are public — they are sent to the browser by design.
# The service-role key is a SECRET: it bypasses all access rules. It must never
# appear in a NEXT_PUBLIC_ variable, in git, or in a chat window.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=uploads

# --- Auth --------------------------------------------------------------------
AUTH_SECRET=PASTE_A_LONG_RANDOM_STRING
