// Chindagram — Prisma schema
// SQLite for the prototype; swap provider to "postgresql" when going live.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String?  @unique // @handle, used for mentions and profile links
  name         String
  passwordHash String
  bio          String?
  image        String?
  pronouns     String?
  interests    String?  // comma-separated
  links        String?  // newline-separated URLs
  theme        String   @default("default") // profile accent theme
  role         String   @default("STUDENT") // STUDENT | PARENT | TEACHER | ADMIN
  gradeClass   String?  // e.g. "Class 6B" — shown as a badge
  private      Boolean  @default(true) // Student/Parent default private; Teacher/Admin are always public regardless of this flag
  disabled     Boolean  @default(false)
  createdAt    DateTime @default(now())

  posts       Post[]
  comments    Comment[]
  likes       Like[]
  saves       Save[]
  following   Follow[]  @relation("follower")
  followers   Follow[]  @relation("following")
  reportsMade Report[]  @relation("reporter")
  stories     Story[]

  messagesSent   Message[]      @relation("sender")
  conversationsCreated    Conversation[]       @relation("conversationCreator")
  conversationMemberships ConversationMember[]
  messageReactions        MessageReaction[]

  notifications     Notification[] @relation("notifRecipient")
  notificationsMade Notification[] @relation("notifActor")

  // Parent <-> child links (a Parent account can be linked to one or more Students)
  childrenLinks ParentLink[] @relation("parentSide")
  parentLinks   ParentLink[] @relation("childSide")

  pollVotes PollVote[]

  // Profile wall: posts I wrote on walls, and posts written on my wall.
  wallPostsWritten WallPost[] @relation("wallAuthor")
  wallPostsOnMine  WallPost[] @relation("wallOwner")

  collaborations PostCollaborator[]

  // Mutual friend requests I've sent / received (separate from one-way Follow).
  friendRequestsSent     Friendship[] @relation("friendRequester")
  friendRequestsReceived Friendship[] @relation("friendAddressee")

  // My close-friends list, and lists I appear on.
  closeFriends   CloseFriend[] @relation("closeFriendOwner")
  closeFriendOf  CloseFriend[] @relation("closeFriendTarget")

  // Blocking (I block someone / someone blocks me) and muting (one-way, feed-only).
  blocksMade Block[] @relation("blocker")
  blockedBy  Block[] @relation("blocked")
  mutesMade  Mute[]  @relation("muter")
  mutedBy    Mute[]  @relation("muted")

  clubsCreated Club[]
  clubMemberships ClubMember[]

  eventsCreated Event[]     @relation("eventCreator")
  eventRSVPs    EventRSVP[]

  commentLikes CommentLike[]
  saveCollections SaveCollection[]
}

// Mutual friend request. Becomes a real "friendship" once accepted — check
// both directions when asking "are A and B friends".
model Friendship {
  id        String   @id @default(cuid())
  status    String   @default("PENDING") // PENDING | ACCEPTED
  createdAt DateTime @default(now())

  requesterId String
  requester   User   @relation("friendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User   @relation("friendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

// Owner's close-friends list (one-way, like Instagram's — not consumed yet;
// groundwork for close-friends-only stories in a later phase).
model CloseFriend {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  ownerId  String
  owner    User   @relation("closeFriendOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  friendId String
  friend   User   @relation("closeFriendTarget", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([ownerId, friendId])
}

// Blocking someone stops all contact both ways (follow, DM, visibility).
// A block from either side counts — only the original blocker can undo it.
model Block {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  blockerId String
  blocker   User   @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User   @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// Muting is one-way and quiet: hides someone's posts from your own feed only.
model Mute {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  muterId String
  muter   User   @relation("muter", fields: [muterId], references: [id], onDelete: Cascade)
  mutedId String
  muted   User   @relation("muted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@unique([muterId, mutedId])
}

// Minimal club/community groundwork — full management (join requests, events,
// files, pinned posts) lands in the later Communities phase. Created by
// teachers/admins; students join and leave instantly for now.
model Club {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  members ClubMember[]
  posts   Post[]
  events  Event[]
}

model ClubMember {
  id       String   @id @default(cuid())
  status   String   @default("ACCEPTED") // PENDING (awaiting a club admin's OK) | ACCEPTED
  role     String   @default("MEMBER")   // MEMBER | ADMIN (any member can be promoted, not just Teacher/Admin accounts)
  joinedAt DateTime @default(now())

  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
  @@index([clubId, status])
}

// Create/RSVP/calendar. Always created by a Teacher/Admin (spec's rule,
// independent of club-admin status), optionally tied to a club or a class
// label — neither set means a school-wide event.
model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  location    String?
  startAt     DateTime
  endAt       DateTime?
  createdAt   DateTime  @default(now())

  createdById String
  createdBy   User   @relation("eventCreator", fields: [createdById], references: [id], onDelete: Cascade)

  clubId     String?
  club       Club?   @relation(fields: [clubId], references: [id], onDelete: SetNull)
  gradeClass String? // ties the event to a class label, mirrors User.gradeClass / classmateIds()

  rsvps EventRSVP[]

  @@index([startAt])
  @@index([clubId])
}

model EventRSVP {
  id        String   @id @default(cuid())
  status    String   // GOING | INTERESTED | NOT_GOING
  createdAt DateTime @default(now())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

// A post written on someone's profile wall. Moderated like everything else.
model WallPost {
  id         String   @id @default(cuid())
  body       String
  removed    Boolean  @default(false)
  status     String   @default("VISIBLE") // VISIBLE | PENDING
  flagReason String?
  createdAt  DateTime @default(now())

  ownerId  String
  owner    User   @relation("wallOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation("wallAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  reports Report[]

  @@index([ownerId, createdAt])
  @@index([status])
}

// Simple key/value store for school-wide settings (e.g. requireApproval).
model AppSetting {
  key   String @id
  value String
}

// Lightweight connection from a Parent account to a Student account.
// A parent can see the child's profile/public posts; never DMs or private activity.
model ParentLink {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  parentId String
  parent   User   @relation("parentSide", fields: [parentId], references: [id], onDelete: Cascade)
  childId  String
  child    User   @relation("childSide", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
  @@index([parentId])
  @@index([childId])
}

model Post {
  id         String   @id @default(cuid())
  kind       String   @default("PHOTO") // PHOTO | REEL | TEXT | LINK | POLL | AUDIO | DOCUMENT | REPOST
  caption    String?
  linkUrl    String?  // for LINK posts
  category   String   @default("NONE") // NONE | ANNOUNCEMENT | ACHIEVEMENT | TIMETABLE | LOSTFOUND (school posts)
  pinned     Boolean  @default(false)  // pinned to the author's profile, OR within the club feed if clubId is set
  removed    Boolean  @default(false)
  status     String   @default("VISIBLE") // VISIBLE | PENDING (held for review)
  flagReason String?  // why the auto-filter held it (shown to reviewers)
  createdAt  DateTime @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Posted to a club's own feed rather than the author's personal profile.
  // SetNull if the club is deleted later — the post stays as a personal post.
  clubId String?
  club   Club?   @relation(fields: [clubId], references: [id], onDelete: SetNull)

  // Reposting to your own feed (kind = REPOST). SetNull if the original is
  // deleted later — the repost stays as your own content, just unlinked.
  repostOfId String?
  repostOf   Post?   @relation("PostRepost", fields: [repostOfId], references: [id], onDelete: SetNull)
  reposts    Post[]  @relation("PostRepost")

  media         PostMedia[]
  comments      Comment[]
  likes         Like[]
  saves         Save[]
  reports       Report[]
  pollOptions   PollOption[]
  pollVotes     PollVote[]
  collaborators PostCollaborator[]
  sharedInMessages Message[]
  repostedToStories Story[]

  @@index([authorId, createdAt])
  @@index([kind, createdAt])
  @@index([status, createdAt])
  @@index([clubId, createdAt])
}

// Co-authored posts: an invited user (accepted) co-owns a post; it appears on
// both profiles and both are shown as authors.
model PostCollaborator {
  id        String   @id @default(cuid())
  accepted  Boolean  @default(false)
  createdAt DateTime @default(now())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, accepted])
}

// Poll options + votes (for kind = POLL). One vote per user per poll.
model PollOption {
  id    String @id @default(cuid())
  text  String
  order Int    @default(0)

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes  PollVote[]

  @@index([postId])
}

model PollVote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  postId   String
  post     Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([optionId])
}

model PostMedia {
  id    String  @id @default(cuid())
  url   String
  type  String  @default("IMAGE") // IMAGE | VIDEO | AUDIO | DOCUMENT
  name  String? // original filename (for audio/document downloads)
  order Int     @default(0)

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Story {
  id        String   @id @default(cuid())
  imageUrl  String?  // null when this story is a repost of a post (repostOfId set instead)
  type      String   @default("IMAGE")
  createdAt DateTime @default(now())
  expiresAt DateTime

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Reposting a post to your story — SetNull if the original is later deleted.
  repostOfId String?
  repostOf   Post?   @relation(fields: [repostOfId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@index([authorId])
}

model Comment {
  id         String   @id @default(cuid())
  body       String
  mediaUrl   String?  // an attached image or a built-in GIF
  mediaType  String?  // IMAGE | GIF
  pinned     Boolean  @default(false) // the post author (or a moderator) pinned this to the top
  removed    Boolean  @default(false)
  status     String   @default("VISIBLE") // VISIBLE | PENDING (held for review)
  flagReason String?
  createdAt  DateTime @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  // One level of threaded replies — a reply's parentId points at a top-level comment.
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  reports Report[]
  likes   CommentLike[]

  @@index([postId])
  @@index([status])
  @@index([parentId])
}

model CommentLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
}

model Like {
  id        String   @id @default(cuid())
  type      String   @default("HEART") // HEART | LAUGH | THUMBSUP | PARTY | CLAP — one reaction per user per post
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model Save {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Optional folder. Deleting the folder un-files the save — it doesn't delete it.
  collectionId String?
  collection   SaveCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@unique([userId, postId])
  @@index([userId])
  @@index([collectionId])
}

model SaveCollection {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  saves   Save[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

model Follow {
  id        String   @id @default(cuid())
  status    String   @default("ACCEPTED") // PENDING (awaiting approval on a private account) | ACCEPTED
  createdAt DateTime @default(now())

  followerId  String
  follower    User   @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User   @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId, status])
}

// A 1:1 chat is just a 2-member conversation. `pairKey` (sorted "idA:idB")
// gives 1:1 conversations the same DB-level "only one thread per pair"
// guarantee the old aId/bId unique constraint had; it's null for groups,
// which can have as many separate conversations as people want.
model Conversation {
  id        String   @id @default(cuid())
  isGroup   Boolean  @default(false)
  name      String?  // group display name; 1:1 threads derive a name from the other member
  pairKey   String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  createdById String?
  createdBy   User?   @relation("conversationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  members  ConversationMember[]
  messages Message[]

  @@index([updatedAt])
}

model ConversationMember {
  id       String   @id @default(cuid())
  role     String   @default("MEMBER") // MEMBER | ADMIN (group admin — rename group, add/remove members)
  joinedAt DateTime @default(now())

  // "Seen up to" this point — simpler than a per-message read row, and it's
  // what read receipts actually need (1:1 "Seen HH:MM", group "Seen by N").
  lastReadAt DateTime?

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  body      String   // may be empty when sharedPostId or mediaUrl is set
  removed   Boolean  @default(false)
  createdAt DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)

  // Sharing a post into a DM — SetNull if the original is later deleted.
  sharedPostId String?
  sharedPost   Post?   @relation(fields: [sharedPostId], references: [id], onDelete: SetNull)

  // Replying to another message in the same conversation.
  parentId String?
  parent   Message?  @relation("messageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies  Message[] @relation("messageReplies")

  // Image/video/voice-note attachment.
  mediaUrl  String?
  mediaType String? // IMAGE | VIDEO | VOICE

  reactions MessageReaction[]
  reports   Report[]

  @@index([conversationId, createdAt])
}

model MessageReaction {
  id        String   @id @default(cuid())
  type      String   // same REACTIONS set as post reactions (lib/reactions.js)
  createdAt DateTime @default(now())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String   // LIKE | COMMENT | FOLLOW | MESSAGE | MENTION | COLLAB | FOLLOW_REQUEST | FOLLOW_ACCEPT | FRIEND_REQUEST | FRIEND_ACCEPT
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  recipientId String
  recipient   User   @relation("notifRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User   @relation("notifActor", fields: [actorId], references: [id], onDelete: Cascade)

  postId  String?
  clubId  String?
  eventId String?

  @@index([recipientId, read])
  @@index([recipientId, createdAt])
}

model Report {
  id        String   @id @default(cuid())
  reason    String?
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  reporterId String
  reporter   User    @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  wallPostId String?
  wallPost   WallPost? @relation(fields: [wallPostId], references: [id], onDelete: Cascade)

  @@index([status])
}
