// Chindagram — Prisma schema
// SQLite for the prototype; swap provider to "postgresql" when going live.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String?  @unique // @handle, used for mentions and profile links
  name         String
  passwordHash String
  bio          String?
  image        String?
  pronouns     String?
  interests    String?  // comma-separated
  links        String?  // newline-separated URLs
  theme        String   @default("default") // profile accent theme
  role         String   @default("STUDENT") // STUDENT | PARENT | TEACHER | ADMIN
  gradeClass   String?  // e.g. "Class 6B" — shown as a badge
  private      Boolean  @default(true) // Student/Parent default private; Teacher/Admin are always public regardless of this flag
  disabled     Boolean  @default(false)
  createdAt    DateTime @default(now())

  posts       Post[]
  comments    Comment[]
  likes       Like[]
  saves       Save[]
  following   Follow[]  @relation("follower")
  followers   Follow[]  @relation("following")
  reportsMade Report[]  @relation("reporter")
  stories     Story[]

  messagesSent   Message[]      @relation("sender")
  conversationsA Conversation[] @relation("aSide")
  conversationsB Conversation[] @relation("bSide")

  notifications     Notification[] @relation("notifRecipient")
  notificationsMade Notification[] @relation("notifActor")

  // Parent <-> child links (a Parent account can be linked to one or more Students)
  childrenLinks ParentLink[] @relation("parentSide")
  parentLinks   ParentLink[] @relation("childSide")

  pollVotes PollVote[]

  // Profile wall: posts I wrote on walls, and posts written on my wall.
  wallPostsWritten WallPost[] @relation("wallAuthor")
  wallPostsOnMine  WallPost[] @relation("wallOwner")

  collaborations PostCollaborator[]

  // Mutual friend requests I've sent / received (separate from one-way Follow).
  friendRequestsSent     Friendship[] @relation("friendRequester")
  friendRequestsReceived Friendship[] @relation("friendAddressee")

  // My close-friends list, and lists I appear on.
  closeFriends   CloseFriend[] @relation("closeFriendOwner")
  closeFriendOf  CloseFriend[] @relation("closeFriendTarget")

  // Blocking (I block someone / someone blocks me) and muting (one-way, feed-only).
  blocksMade Block[] @relation("blocker")
  blockedBy  Block[] @relation("blocked")
  mutesMade  Mute[]  @relation("muter")
  mutedBy    Mute[]  @relation("muted")

  clubsCreated Club[]
  clubMemberships ClubMember[]
}

// Mutual friend request. Becomes a real "friendship" once accepted — check
// both directions when asking "are A and B friends".
model Friendship {
  id        String   @id @default(cuid())
  status    String   @default("PENDING") // PENDING | ACCEPTED
  createdAt DateTime @default(now())

  requesterId String
  requester   User   @relation("friendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User   @relation("friendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

// Owner's close-friends list (one-way, like Instagram's — not consumed yet;
// groundwork for close-friends-only stories in a later phase).
model CloseFriend {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  ownerId  String
  owner    User   @relation("closeFriendOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  friendId String
  friend   User   @relation("closeFriendTarget", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([ownerId, friendId])
}

// Blocking someone stops all contact both ways (follow, DM, visibility).
// A block from either side counts — only the original blocker can undo it.
model Block {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  blockerId String
  blocker   User   @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User   @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// Muting is one-way and quiet: hides someone's posts from your own feed only.
model Mute {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  muterId String
  muter   User   @relation("muter", fields: [muterId], references: [id], onDelete: Cascade)
  mutedId String
  muted   User   @relation("muted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@unique([muterId, mutedId])
}

// Minimal club/community groundwork — full management (join requests, events,
// files, pinned posts) lands in the later Communities phase. Created by
// teachers/admins; students join and leave instantly for now.
model Club {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  members ClubMember[]
}

model ClubMember {
  id       String   @id @default(cuid())
  joinedAt DateTime @default(now())

  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
}

// A post written on someone's profile wall. Moderated like everything else.
model WallPost {
  id         String   @id @default(cuid())
  body       String
  removed    Boolean  @default(false)
  status     String   @default("VISIBLE") // VISIBLE | PENDING
  flagReason String?
  createdAt  DateTime @default(now())

  ownerId  String
  owner    User   @relation("wallOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation("wallAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  reports Report[]

  @@index([ownerId, createdAt])
  @@index([status])
}

// Simple key/value store for school-wide settings (e.g. requireApproval).
model AppSetting {
  key   String @id
  value String
}

// Lightweight connection from a Parent account to a Student account.
// A parent can see the child's profile/public posts; never DMs or private activity.
model ParentLink {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  parentId String
  parent   User   @relation("parentSide", fields: [parentId], references: [id], onDelete: Cascade)
  childId  String
  child    User   @relation("childSide", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
  @@index([parentId])
  @@index([childId])
}

model Post {
  id         String   @id @default(cuid())
  kind       String   @default("PHOTO") // PHOTO | REEL | TEXT | LINK | POLL | AUDIO | DOCUMENT
  caption    String?
  linkUrl    String?  // for LINK posts
  category   String   @default("NONE") // NONE | ANNOUNCEMENT | ACHIEVEMENT | TIMETABLE | LOSTFOUND (school posts)
  pinned     Boolean  @default(false)  // pinned to the author's profile
  removed    Boolean  @default(false)
  status     String   @default("VISIBLE") // VISIBLE | PENDING (held for review)
  flagReason String?  // why the auto-filter held it (shown to reviewers)
  createdAt  DateTime @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  media         PostMedia[]
  comments      Comment[]
  likes         Like[]
  saves         Save[]
  reports       Report[]
  pollOptions   PollOption[]
  pollVotes     PollVote[]
  collaborators PostCollaborator[]

  @@index([authorId, createdAt])
  @@index([kind, createdAt])
  @@index([status, createdAt])
}

// Co-authored posts: an invited user (accepted) co-owns a post; it appears on
// both profiles and both are shown as authors.
model PostCollaborator {
  id        String   @id @default(cuid())
  accepted  Boolean  @default(false)
  createdAt DateTime @default(now())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, accepted])
}

// Poll options + votes (for kind = POLL). One vote per user per poll.
model PollOption {
  id    String @id @default(cuid())
  text  String
  order Int    @default(0)

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes  PollVote[]

  @@index([postId])
}

model PollVote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  postId   String
  post     Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([optionId])
}

model PostMedia {
  id    String  @id @default(cuid())
  url   String
  type  String  @default("IMAGE") // IMAGE | VIDEO | AUDIO | DOCUMENT
  name  String? // original filename (for audio/document downloads)
  order Int     @default(0)

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Story {
  id        String   @id @default(cuid())
  imageUrl  String
  type      String   @default("IMAGE")
  createdAt DateTime @default(now())
  expiresAt DateTime

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([authorId])
}

model Comment {
  id         String   @id @default(cuid())
  body       String
  removed    Boolean  @default(false)
  status     String   @default("VISIBLE") // VISIBLE | PENDING (held for review)
  flagReason String?
  createdAt  DateTime @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  reports  Report[]

  @@index([postId])
  @@index([status])
}

model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model Save {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
}

model Follow {
  id        String   @id @default(cuid())
  status    String   @default("ACCEPTED") // PENDING (awaiting approval on a private account) | ACCEPTED
  createdAt DateTime @default(now())

  followerId  String
  follower    User   @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User   @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId, status])
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  aId String
  a   User   @relation("aSide", fields: [aId], references: [id], onDelete: Cascade)
  bId String
  b   User   @relation("bSide", fields: [bId], references: [id], onDelete: Cascade)

  messages Message[]

  @@unique([aId, bId])
  @@index([aId])
  @@index([bId])
}

model Message {
  id        String   @id @default(cuid())
  body      String
  removed   Boolean  @default(false)
  createdAt DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)

  reports Report[]

  @@index([conversationId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  type      String   // LIKE | COMMENT | FOLLOW | MESSAGE | MENTION | COLLAB | FOLLOW_REQUEST | FOLLOW_ACCEPT | FRIEND_REQUEST | FRIEND_ACCEPT
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  recipientId String
  recipient   User   @relation("notifRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User   @relation("notifActor", fields: [actorId], references: [id], onDelete: Cascade)

  postId String?

  @@index([recipientId, read])
  @@index([recipientId, createdAt])
}

model Report {
  id        String   @id @default(cuid())
  reason    String?
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  reporterId String
  reporter   User    @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  wallPostId String?
  wallPost   WallPost? @relation(fields: [wallPostId], references: [id], onDelete: Cascade)

  @@index([status])
}
